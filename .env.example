# Copy to .env and adjust. Real secrets never go into the repository.
# These values match docker-compose.yml (host ports 15432, 15433 and 16379).

# Shared by subscription and tracking: the key for X-API-Key and x-api-key.
APP_API_KEY=change-me

# subscription
APP_HTTP_PORT=8080
DB_URL=postgres://subscription:subscription@localhost:15432/subscription_db?sslmode=disable
TRACKING_GRPC_ADDR=localhost:9090
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=
RATE_LIMIT=10-S

# tracking
WORKER_HEALTH_PORT=8081
APP_GRPC_PORT=9090
# DB_URL for tracking: postgres://tracker:tracker@localhost:15433/tracker_db?sslmode=disable
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_HTTP_TIMEOUT=3s

# notification
SENDER_HEALTH_PORT=8082
